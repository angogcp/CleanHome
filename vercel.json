{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "resources/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/resources/(.*)", "dest": "/resources/$1" },
    { "src": "/(.*\\.html)", "dest": "/$1" },
    { "src": "/(.*\\.js)", "dest": "/$1" },
    { "src": "/(.*\\.css)", "dest": "/$1" },
    { "src": "/(.*\\.png)", "dest": "/$1" },
    { "src": "/(.*\\.jpg)", "dest": "/$1" },
    { "src": "/(.*\\.ico)", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/server.js" }
  ],
  "env": {
    "NEON_DATABASE_URL": "postgresql://neondb_owner:npg_8sMKa9JgVWvZ@ep-autumn-term-a1cx10zw-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
  }
}